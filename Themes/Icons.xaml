    <!-- ================================================
         REUSABLE: VectorIcon control style
         Usage:
           <ContentControl Style="{StaticResource VectorIcon}"
                           Content="{StaticResource IconPlay}"
                           Width="20" Height="20"/>
    ================================================ -->
    <Style x:Key="VectorIcon" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Width="{TemplateBinding Width}"
                             Height="{TemplateBinding Height}"
                             Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{TemplateBinding Foreground}"
                                  Data="{TemplateBinding Content}"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent-colored vector icon -->
    <Style x:Key="VectorIconAccent" TargetType="ContentControl" BasedOn="{StaticResource VectorIcon}">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
    </Style>

    <!-- Secondary-colored vector icon -->
    <Style x:Key="VectorIconSecondary" TargetType="ContentControl" BasedOn="{StaticResource VectorIcon}">
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
    </Style>

</ResourceDictionary>
