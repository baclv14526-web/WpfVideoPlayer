<Window x:Class="WpfVideoPlayer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:conv="clr-namespace:WpfVideoPlayer.Converters"
        xmlns:vm="clr-namespace:WpfVideoPlayer.ViewModels"
        xmlns:models="clr-namespace:WpfVideoPlayer.Models"
        Title="VPlayer" Height="680" Width="1100" MinHeight="500" MinWidth="800"
        Icon="/Assets/app.ico"
        Background="{StaticResource BrushBgDeep}"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        MouseMove="Window_MouseMove"
        Closed="Window_Closed">

    <Window.Resources>
        <conv:BoolToPlayPauseConverter x:Key="PlayPauseConv"/>
        <conv:BoolToMuteIconConverter x:Key="MuteIconConv"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True"/>
        <conv:BoolToAccentBrushConverter x:Key="AccentBrush"/>
        <conv:BoolToFullscreenIconConverter x:Key="FullscreenConv"/>
        <conv:BoolToPlaylistWidthConverter x:Key="PlaylistWidthConv"/>
        <conv:NormalizedToLeftConverter x:Key="NormToLeftConv"/>
        <conv:EqualityToVisibilityConverter x:Key="EqToVis"/>
        <conv:EqualityToBrushConverter x:Key="EqToBrush"/>
        <conv:StringToSolidBrushConverter x:Key="StrToBrush"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Space" Command="{Binding PlayPauseCommand}"/>
        <KeyBinding Key="Left" Command="{Binding SeekBackCommand}"/>
        <KeyBinding Key="Right" Command="{Binding SeekForwardCommand}"/>
        <KeyBinding Key="J" Command="{Binding SeekBack30SecCommand}"/>
        <KeyBinding Key="L" Command="{Binding SeekForward1MinCommand}"/>
        <KeyBinding Key="Left" Modifiers="Ctrl" Command="{Binding SeekBack30SecCommand}"/>
        <KeyBinding Key="Right" Modifiers="Ctrl" Command="{Binding SeekForward1MinCommand}"/>
        <KeyBinding Key="PageDown" Command="{Binding SeekBack30SecCommand}"/>
        <KeyBinding Key="PageUp" Command="{Binding SeekForward1MinCommand}"/>
        <KeyBinding Key="Up" Command="{Binding VolumeUpCommand}"/>
        <KeyBinding Key="Down" Command="{Binding VolumeDownCommand}"/>
        <KeyBinding Key="M" Command="{Binding ToggleMuteCommand}"/>
        <KeyBinding Key="F" Command="{Binding ToggleFullscreenCommand}"/>
        <KeyBinding Key="OemOpenBrackets" Command="{Binding SpeedDownCommand}"/>
        <KeyBinding Key="OemCloseBrackets" Command="{Binding SpeedUpCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding ExitFullscreenCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenFileCommand}"/>
        <!-- Zoom: Ctrl+= ZoomIn, Ctrl+- ZoomOut, Ctrl+0 Fit -->
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding FitToScreenCommand}"/>
        <!-- Rotate: Ctrl+R CW, Ctrl+Shift+R CCW -->
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RotateCWCommand}"/>
        <KeyBinding Key="R" Modifiers="Ctrl,Shift" Command="{Binding RotateCCWCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title bar -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Controls -->
        </Grid.RowDefinitions>

        <!-- ══ TITLE BAR ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}" Height="40"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                Visibility="{Binding IsFullscreen, Converter={StaticResource BoolToVisInv}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App name + icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" 
                            VerticalAlignment="Center" Margin="14,0">
                    <ContentControl Style="{StaticResource VectorIconAccent}"
                                    Content="{StaticResource IconAppLogo}"
                                    Width="18" Height="18" Margin="0,0,8,0"
                                    VerticalAlignment="Center"/>
                    <TextBlock Text="VPlayer" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Current title -->
                <TextBlock Grid.Column="1" Text="{Binding CurrentTitle}" 
                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="20,0"/>

                <!-- Window controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Padding="12,0" Height="40" Click="MinimizeButton_Click">
                        <ContentControl Style="{StaticResource VectorIcon}"
                                        Content="{StaticResource IconMinimize}"
                                        Width="14" Height="14"/>
                    </Button>
                    <Button x:Name="MaxRestoreBtn" Style="{StaticResource IconButtonStyle}"
                            Padding="12,0" Height="40" Click="MaximizeButton_Click">
                        <ContentControl Style="{StaticResource VectorIcon}"
                                        Content="{StaticResource IconMaximize}"
                                        Width="13" Height="13"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Padding="12,0" Height="40" Click="CloseButton_Click">
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                        To="#CC2222" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                        <ContentControl Style="{StaticResource VectorIcon}"
                                        Content="{StaticResource IconClose}"
                                        Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ MAIN CONTENT ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding IsPlaylistVisible, Converter={StaticResource PlaylistWidthConv}}"/>
            </Grid.ColumnDefinitions>

            <!-- Video area -->
            <Border Grid.Column="0" Background="Black" AllowDrop="True"
                    Drop="VideoArea_Drop" DragOver="VideoArea_DragOver"
                    MouseLeftButtonDown="VideoArea_MouseLeftButtonDown">
                <Grid>
                    <!-- VLC video surface -->
                    <vlc:VideoView x:Name="VideoView" MediaPlayer="{Binding MediaPlayer}"
                                   Background="Black"/>

                    <!-- Drop hint overlay -->
                    <Border x:Name="DropHint" Background="#CC000000" 
                            Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisInv}}"
                            IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentControl Style="{StaticResource VectorIconAccent}"
                                            Content="{StaticResource IconFilm}"
                                            Width="72" Height="72"
                                            HorizontalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Text="Kéo thả video vào đây" FontSize="20" FontWeight="Light"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       HorizontalAlignment="Center" Margin="0,20,0,8"/>
                            <TextBlock Text="MP4 · MKV · AVI · MOV · WMV · FLV · WebM · và nhiều hơn nữa"
                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                       HorizontalAlignment="Center" Opacity="0.6"/>
                            <Button Margin="0,24,0,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding OpenFileCommand}"
                                    HorizontalAlignment="Center" Padding="24,10" FontSize="14">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource VectorIcon}"
                                                    Content="{StaticResource IconOpenFile}"
                                                    Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="Chọn tệp video..." VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Loading spinner -->
                    <Border Background="#99000000"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                            IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentControl Style="{StaticResource VectorIconAccent}"
                                            Content="{StaticResource IconLoading}"
                                            Width="40" Height="40"
                                            HorizontalAlignment="Center"/>
                            <TextBlock Text="Đang mở..." FontSize="13"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Video info overlay (top-right) -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                            Background="#AA000000" CornerRadius="4" Padding="8,4"
                            Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding VideoInfo}" FontSize="11"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Sidebar Panel (Playlist & Motion Bookmarks) -->
            <Border Grid.Column="1" Background="{StaticResource BrushBgPanel}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsPlaylistVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Tab Headers -->
                        <RowDefinition Height="*"/>    <!-- Tab Content -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
                    </Grid.RowDefinitions>

                    <!-- ── Tab Headers ─────────────────────────────────────────── -->
                    <Border Grid.Row="0" Padding="8,8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Playlist Tab Button -->
                            <Button Grid.Column="0" Command="{Binding SwitchSidebarTabCommand}" CommandParameter="0"
                                    Style="{StaticResource SpeedButtonStyle}" Margin="2,0" Padding="8,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ContentControl Style="{StaticResource VectorIcon}"
                                                    Content="{StaticResource IconPlaylist}"
                                                    Width="14" Height="14" Margin="0,0,5,0"
                                                    Foreground="{Binding ActiveSidebarTabIndex, Converter={StaticResource EqToBrush}, ConverterParameter=0, Mode=OneWay}"/>
                                    <TextBlock Text="Playlist" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding ActiveSidebarTabIndex, Converter={StaticResource EqToBrush}, ConverterParameter=0, Mode=OneWay}"/>
                                    <Border Background="{StaticResource BrushAccent}" CornerRadius="8" 
                                            Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Playlist.Count}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Motion Bookmarks Tab Button -->
                            <Button Grid.Column="1" Command="{Binding SwitchSidebarTabCommand}" CommandParameter="1"
                                    Style="{StaticResource SpeedButtonStyle}" Margin="2,0" Padding="8,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ContentControl Style="{StaticResource VectorIcon}"
                                                    Content="{StaticResource IconMotion}"
                                                    Width="14" Height="14" Margin="0,0,5,0"
                                                    Foreground="{Binding ActiveSidebarTabIndex, Converter={StaticResource EqToBrush}, ConverterParameter=1, Mode=OneWay}"/>
                                    <TextBlock Text="Cảnh ≥2 Người" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding ActiveSidebarTabIndex, Converter={StaticResource EqToBrush}, ConverterParameter=1, Mode=OneWay}"/>
                                    <Border Background="#FF4757" CornerRadius="8" 
                                            Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Bookmarks.Count}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ── TAB 0: PLAYLIST ─────────────────────────────────────── -->
                    <Grid Grid.Row="1" Visibility="{Binding ActiveSidebarTabIndex, Converter={StaticResource EqToVis}, ConverterParameter=0}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Playlist items -->
                        <ListBox Grid.Row="0" x:Name="PlaylistBox"
                                 ItemsSource="{Binding Playlist}"
                                 SelectedIndex="{Binding SelectedPlaylistIndex}"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource PlaylistItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PlaylistItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FileNameWithoutExt}"
                                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="{Binding Duration}"
                                                       FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Padding="4"
                                                Visibility="Hidden" x:Name="removeBtn"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.RemoveFromPlaylistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                            <ContentControl Style="{StaticResource VectorIcon}"
                                                            Content="{StaticResource IconClose}"
                                                            Width="11" Height="11"
                                                            Foreground="{StaticResource BrushTextSecondary}"/>
                                        </Button>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="removeBtn" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Add to playlist buttons -->
                        <Border Grid.Row="1" Padding="8,8"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding OpenFileCommand}" Margin="4,0" Padding="12,6" FontSize="12">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Style="{StaticResource VectorIcon}"
                                                            Content="{StaticResource IconOpenFile}"
                                                            Width="13" Height="13" Margin="0,0,5,0"/>
                                            <TextBlock Text="File" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding OpenFolderCommand}" Margin="4,0" Padding="12,6" FontSize="12">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Style="{StaticResource VectorIcon}"
                                                            Content="{StaticResource IconOpenFolder}"
                                                            Width="13" Height="13" Margin="0,0,5,0"/>
                                            <TextBlock Text="Folder" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Button Style="{StaticResource IconButtonStyle}"
                                        HorizontalAlignment="Right" Padding="8"
                                        Command="{Binding ClearPlaylistCommand}"
                                        ToolTip="Xóa tất cả playlist">
                                    <ContentControl Style="{StaticResource VectorIcon}"
                                                    Content="{StaticResource IconTrash}"
                                                    Width="16" Height="16"
                                                    Foreground="#FF6B6B"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ── TAB 1: MOTION BOOKMARKS (2+ PERSONS ONLY) ───────────── -->
                    <Grid Grid.Row="1" Visibility="{Binding ActiveSidebarTabIndex, Converter={StaticResource EqToVis}, ConverterParameter=1}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Scan Toolbar -->
                            <RowDefinition Height="Auto"/> <!-- Progress / Status -->
                            <RowDefinition Height="*"/>    <!-- Bookmarks List -->
                        </Grid.RowDefinitions>

                        <!-- Motion scan toolbar -->
                        <Border Grid.Row="0" Padding="10,8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Scan button -->
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Padding="10,5" FontSize="11"
                                            Command="{Binding ScanMotionCommand}"
                                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisInv}}"
                                            ToolTip="Quét AI YOLO tìm cảnh có từ 2 người trở lên">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Style="{StaticResource VectorIcon}"
                                                            Content="{StaticResource IconSearch}"
                                                            Width="13" Height="13" Margin="0,0,5,0"/>
                                            <TextBlock Text="Quét cảnh ≥2 người" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Random 10 bookmarks button (Fast, non-YOLO) -->
                                    <Button Style="{StaticResource SpeedButtonStyle}" Margin="6,0,0,0" Padding="8,5" FontSize="11"
                                            Command="{Binding GenerateRandomBookmarksCommand}"
                                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisInv}}"
                                            ToolTip="Tạo nhanh 10 mốc ngẫu nhiên trên timeline kèm ảnh preview (không dùng AI)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🎲" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="10 Mốc ngẫu nhiên" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Cancel button -->
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Background="#CC3333" Padding="10,5" FontSize="11"
                                            Command="{Binding CancelScanCommand}"
                                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Dừng tiến trình quét">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Style="{StaticResource VectorIcon}"
                                                            Content="{StaticResource IconCancelScan}"
                                                            Width="13" Height="13" Margin="0,0,5,0"/>
                                            <TextBlock Text="Hủy" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Auto scan toggle -->
                                    <CheckBox IsChecked="{Binding AutoScanOnOpen}" Margin="10,0,0,0" VerticalAlignment="Center"
                                              ToolTip="Tự động nhận diện cảnh có từ 2 người trở lên khi mở video mới">
                                        <TextBlock Text="Tự quét" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                    </CheckBox>
                                </StackPanel>

                                <!-- Clear bookmarks button -->
                                <Button Style="{StaticResource IconButtonStyle}"
                                        HorizontalAlignment="Right" Padding="8"
                                        Command="{Binding ClearBookmarksCommand}"
                                        ToolTip="Xóa tất cả bookmark">
                                    <ContentControl Style="{StaticResource VectorIcon}"
                                                    Content="{StaticResource IconTrash}"
                                                    Width="16" Height="16"
                                                    Foreground="#FF6B6B"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Progress Bar & Status Text -->
                        <Border Grid.Row="1" Padding="10,6" Background="{StaticResource BrushBgCard}"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <ProgressBar Style="{StaticResource ScanProgressBarStyle}"
                                             Value="{Binding ScanProgress, Mode=OneWay}" Maximum="100"
                                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                                             Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding ScanStatusText}" FontSize="11"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Bookmarks items list -->
                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding Bookmarks}"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource PlaylistItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:MotionBookmark}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Image Thumbnail Preview -->
                                        <Border Grid.Column="0" Width="72" Height="44" CornerRadius="4"
                                                Background="#1E1E28" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                                ClipToBounds="True" Margin="0,0,8,0">
                                            <Grid>
                                                <!-- Image if present -->
                                                <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"/>

                                                <!-- Fallback if no image -->
                                                <Border Background="{Binding BadgeColor, Converter={StaticResource StrToBrush}}"
                                                        Opacity="0.25"
                                                        Visibility="{Binding PreviewImage, Converter={StaticResource BoolToVisInv}}"/>
                                                <TextBlock Text="{Binding Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding PreviewImage, Converter={StaticResource BoolToVisInv}}"/>

                                                <!-- Mini time badge on bottom right of thumbnail -->
                                                <Border Background="#CC000000" CornerRadius="2" Padding="3,1"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="2">
                                                    <TextBlock Text="{Binding TimeText}" FontSize="9" FontFamily="Consolas"
                                                               Foreground="#FFFFFF"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="18" Height="18" CornerRadius="9"
                                                        Background="{Binding BadgeColor, Converter={StaticResource StrToBrush}}"
                                                        VerticalAlignment="Center" Margin="0,0,5,0">
                                                    <TextBlock Text="{Binding Icon}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"
                                                           MaxWidth="170" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding TimeText}" FontSize="11" FontFamily="Consolas"
                                                           Foreground="{StaticResource BrushAccentLight}"/>
                                                <TextBlock Text="{Binding DurationSeconds, StringFormat=' · ~{0:0.#}s'}" FontSize="10"
                                                           Foreground="{StaticResource BrushTextSecondary}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Jump button -->
                                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Padding="6,4"
                                                Command="{Binding DataContext.JumpToBookmarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Nhảy ngay tới cảnh này">
                                            <ContentControl Style="{StaticResource VectorIconAccent}"
                                                            Content="{StaticResource IconJump}"
                                                            Width="15" Height="15"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ CONTROLS BAR ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="2" x:Name="ControlsBar" Background="{StaticResource BrushBgPanel}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                Padding="0,0,0,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>  <!-- Seek bar -->
                    <RowDefinition Height="52"/>  <!-- Buttons + Volume -->
                </Grid.RowDefinitions>

                <!-- Seek bar row -->
                <Grid Grid.Row="0" Margin="12,4,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding CurrentTimeText}" FontSize="11" FontFamily="Consolas"
                               Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"
                               Margin="0,0,10,0" MinWidth="50"/>

                    <!-- Seek Bar + Motion Bookmarks Overlay -->
                    <Grid Grid.Column="1" VerticalAlignment="Center"
                          x:Name="SeekBarContainer"
                          Background="Transparent"
                          PreviewMouseMove="SeekBar_PreviewMouseMove"
                          MouseLeave="SeekBar_MouseLeave">
                        <!-- Main Seek Slider -->
                        <Slider Style="{StaticResource SeekBarStyle}"
                                x:Name="MainSeekSlider"
                                Minimum="0" Maximum="1" Value="{Binding Position, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding HasMedia}"
                                MouseLeftButtonDown="SeekBar_PreviewMouseDown"
                                PreviewMouseLeftButtonUp="SeekBar_PreviewMouseUp"/>

                        <!-- Bookmarks Pins Overlay with Rich Preview Tooltips -->
                        <ItemsControl ItemsSource="{Binding Bookmarks}"
                                      IsHitTestVisible="True"
                                      VerticalAlignment="Center"
                                      Margin="0,-16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Height="24" IsItemsHost="True" ClipToBounds="False"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource NormToLeftConv}" ConverterParameter="8" Mode="OneWay">
                                                <Binding Path="NormalizedPosition" Mode="OneWay"/>
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Canvas}" Mode="OneWay"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:MotionBookmark}">
                                    <Button Style="{StaticResource TimelineBookmarkPinStyle}"
                                            Command="{Binding DataContext.JumpToBookmarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <!-- Rich Image Preview Tooltip -->
                                        <Button.ToolTip>
                                            <ToolTip Background="#1E1E2A" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                                     Padding="6">
                                                <StackPanel Width="180">
                                                    <!-- Header -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Icon}" FontSize="12" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding TimeText}" FontSize="11" FontWeight="Bold" FontFamily="Consolas"
                                                                   Foreground="{StaticResource BrushAccentLight}"/>
                                                        <TextBlock Text="{Binding DurationSeconds, StringFormat=' (~{0:0.#}s)'}" FontSize="10"
                                                                   Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Preview Thumbnail -->
                                                    <Border Height="101" CornerRadius="4" ClipToBounds="True" Background="#000000"
                                                            BorderBrush="{Binding BadgeColor, Converter={StaticResource StrToBrush}}" BorderThickness="1.5"
                                                            Margin="0,0,0,4">
                                                        <Grid>
                                                            <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"/>
                                                            <TextBlock Text="{Binding Icon}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Opacity="0.4" Visibility="{Binding PreviewImage, Converter={StaticResource BoolToVisInv}}"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Title / Action description -->
                                                    <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>

                                        <!-- Pin Visual -->
                                        <Grid>
                                            <Border Width="16" Height="16" CornerRadius="8"
                                                    Background="{Binding BadgeColor, Converter={StaticResource StrToBrush}}"
                                                    BorderBrush="#FFFFFF" BorderThickness="1.5"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Margin="0,-1,0,0"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Floating Timeline Hover Preview (Popup overcomes Win32 VideoView Airspace) -->
                        <Popup x:Name="TimelinePreviewPopup"
                               PlacementTarget="{Binding ElementName=MainSeekSlider}"
                               Placement="Top"
                               HorizontalOffset="{Binding TimelineHoverLeft}"
                               VerticalOffset="-10"
                               IsOpen="{Binding IsTimelineHoverPreviewVisible}"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsHitTestVisible="False"
                               PopupAnimation="Fade">
                            <Border Width="194" Height="136" CornerRadius="8"
                                    Background="#14141F" BorderBrush="{StaticResource BrushAccentLight}" BorderThickness="1.5"
                                    Padding="4">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.85"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Live Preview Thumbnail Image -->
                                    <Border Grid.Row="0" CornerRadius="6" ClipToBounds="True" Background="#000000">
                                        <Grid>
                                            <Image Source="{Binding TimelineHoverPreviewImage}" Stretch="UniformToFill"/>
                                            <TextBlock Text="Đang tải..." FontSize="10" Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding TimelineHoverPreviewImage, Converter={StaticResource BoolToVisInv}}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Hover Time & Nearby Bookmark Title -->
                                    <Border Grid.Row="1" Margin="0,4,0,1">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding TimelineHoverBookmark.Icon}" FontSize="11" Margin="0,0,4,0"
                                                       Visibility="{Binding TimelineHoverBookmark, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding TimelineHoverTimeText}" FontSize="11" FontWeight="Bold" FontFamily="Consolas"
                                                       Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="{Binding TimelineHoverBookmark.Title, StringFormat=' - {0}'}" FontSize="10"
                                                       Foreground="{StaticResource BrushAccentLight}" TextTrimming="CharacterEllipsis" MaxWidth="110"
                                                       Visibility="{Binding TimelineHoverBookmark, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>

                    <TextBlock Grid.Column="2" Text="{Binding TotalTimeText}" FontSize="11" FontFamily="Consolas"
                               Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"
                               Margin="10,0,0,0" MinWidth="50" TextAlignment="Right"/>
                </Grid>

                <!-- Buttons row -->
                <Grid Grid.Row="1" Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>   <!-- Left: extra controls -->
                        <ColumnDefinition Width="Auto"/> <!-- Center: main controls -->
                        <ColumnDefinition Width="*"/>   <!-- Right: volume + misc -->
                    </Grid.ColumnDefinitions>

                    <!-- Left zone: open + playlist toggle -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" 
                                Command="{Binding OpenFileCommand}" ToolTip="Mở file (Ctrl+O)" Padding="10">
                            <ContentControl Style="{StaticResource VectorIcon}"
                                            Content="{StaticResource IconOpenFile}"
                                            Width="20" Height="20"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding OpenFolderCommand}" ToolTip="Mở thư mục" Padding="10">
                            <ContentControl Style="{StaticResource VectorIcon}"
                                            Content="{StaticResource IconOpenFolder}"
                                            Width="20" Height="20"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding TogglePlaylistCommand}" ToolTip="Danh sách phát" Padding="10">
                            <ContentControl Style="{StaticResource VectorIcon}"
                                            Content="{StaticResource IconPlaylist}"
                                            Width="20" Height="20"
                                            Foreground="{Binding IsPlaylistVisible, Converter={StaticResource AccentBrush}}"/>
                        </Button>
                    </StackPanel>

                    <!-- Center zone: playback controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" 
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Shuffle -->
                        <Button Style="{StaticResource IconButtonStyle}" Padding="8" Margin="2,0"
                                Command="{Binding ToggleShuffleCommand}" ToolTip="Ngẫu nhiên">
                            <ContentControl Style="{StaticResource VectorIcon}"
                                            Content="{StaticResource IconShuffle}"
                                            Width="18" Height="18"
                                            Foreground="{Binding IsShuffle, Converter={StaticResource AccentBrush}}"/>
                        </Button>
                        <!-- Rewind 30s -->
                        <Button Style="{StaticResource IconButtonStyle}" Padding="6,4" Margin="2,0"
                                Command="{Binding SeekBack30SecCommand}" ToolTip="Lùi 30 giây (J / Ctrl+← / PageDown)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource VectorIcon}"
                                                Content="{StaticResource IconReplay30}"
                                                Width="18" Height="18"/>
                                <TextBlock Text="30s" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="2,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Previous -->
                        <Button Style="{StaticResource IconButtonStyle}" Padding="8" Margin="2,0"
                                Command="{Binding PreviousCommand}" ToolTip="Video trước">
                            <ContentControl Style="{StaticResource VectorIcon}"
                                            Content="{StaticResource IconPrevious}"
                                            Width="20" Height="20"/>
                        </Button>
                        <!-- Play/Pause - prominent -->
                        <Button Style="{StaticResource IconButtonStyle}" Padding="0" Margin="4,0"
                                Command="{Binding PlayPauseCommand}" ToolTip="Phát/Tạm dừng (Space)">
                            <Border Width="48" Height="48" CornerRadius="24" 
                                    Background="{StaticResource BrushAccent}">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Play icon -->
                                    <ContentControl Style="{StaticResource VectorIcon}"
                                                    Content="{StaticResource IconPlay}"
                                                    Width="22" Height="22"
                                                    Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisInv}}"
                                                    Margin="2,0,0,0"/>
                                    <!-- Pause icon -->
                                    <ContentControl Style="{StaticResource VectorIcon}"
                                                    Content="{StaticResource IconPause}"
                                                    Width="22" Height="22"
                                                    Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>
                        </Button>
                        <!-- Next -->
                        <Button Style="{StaticResource IconButtonStyle}" Padding="8" Margin="2,0"
                                Command="{Binding NextCommand}" ToolTip="Video tiếp theo">
                            <ContentControl Style="{StaticResource VectorIcon}"
                                            Content="{StaticResource IconNext}"
                                            Width="20" Height="20"/>
                        </Button>
                        <!-- Forward 1m (60s) -->
                        <Button Style="{StaticResource IconButtonStyle}" Padding="6,4" Margin="2,0"
                                Command="{Binding SeekForward1MinCommand}" ToolTip="Tiến 1 phút (L / Ctrl+→ / PageUp)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="1p" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                <ContentControl Style="{StaticResource VectorIcon}"
                                                Content="{StaticResource IconForward60}"
                                                Width="18" Height="18"/>
                            </StackPanel>
                        </Button>
                        <!-- Repeat -->
                        <Button Style="{StaticResource IconButtonStyle}" Padding="8" Margin="2,0"
                                Command="{Binding ToggleRepeatCommand}" ToolTip="Lặp lại">
                            <ContentControl Style="{StaticResource VectorIcon}"
                                            Content="{StaticResource IconRepeat}"
                                            Width="18" Height="18"
                                            Foreground="{Binding IsRepeat, Converter={StaticResource AccentBrush}}"/>
                        </Button>
                    </StackPanel>

                    <!-- Right zone: volume + status + fullscreen -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" 
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Status text -->
                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   MaxWidth="140" TextTrimming="CharacterEllipsis"/>

                        <!-- Speed & Mode selector button (Consolidated) -->
                        <Button Style="{StaticResource SpeedButtonStyle}"
                                ToolTip="Tốc độ &amp; Chế độ phát thông minh Lx/Ps/Pb (Click để chọn, phím [ / ])"
                                Click="SpeedButton_Click"
                                Margin="0,0,6,0">

                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="── CHẾ ĐỘ PHÁT THÔNG MINH ──" IsEnabled="False" Foreground="{StaticResource BrushTextSecondary}" FontSize="10"/>
                                    <MenuItem Header="Lx: Tuyến tính 1x → 4x"
                                              Command="{Binding ToggleLxModeCommand}"
                                              IsChecked="{Binding IsLxMode, Mode=OneWay}"
                                              ToolTip="Tăng tốc tuyến tính từ 1x đến 4x theo tiến trình video"/>
                                    <MenuItem Header="Ps: Play Step (30s @2x ngẫu nhiên)"
                                              Command="{Binding TogglePsModeCommand}"
                                              IsChecked="{Binding IsPsMode, Mode=OneWay}"
                                              ToolTip="Intro 30s @2x, sau đó nhảy ngẫu nhiên 3-5 điểm phát 30s @2x"/>
                                    <MenuItem Header="Pb: Play Balanced (30s @2x chia đều)"
                                              Command="{Binding TogglePbModeCommand}"
                                              IsChecked="{Binding IsPbMode, Mode=OneWay}"
                                              ToolTip="Intro 30s @2x, sau đó nhảy chia đều theo độ dài video phát 30s @2x"/>
                                    <Separator/>
                                    <MenuItem Header="── TỐC ĐỘ CỐ ĐỊNH ──" IsEnabled="False" Foreground="{StaticResource BrushTextSecondary}" FontSize="10"/>
                                    <MenuItem Header="0.25x" Command="{Binding SetSpeedCommand}" CommandParameter="0.25"/>
                                    <MenuItem Header="0.5x"  Command="{Binding SetSpeedCommand}" CommandParameter="0.5"/>
                                    <MenuItem Header="0.75x" Command="{Binding SetSpeedCommand}" CommandParameter="0.75"/>
                                    <MenuItem Header="1.0x (Chuẩn)" Command="{Binding SetSpeedCommand}" CommandParameter="1.0" FontWeight="SemiBold"/>
                                    <MenuItem Header="1.25x" Command="{Binding SetSpeedCommand}" CommandParameter="1.25"/>
                                    <MenuItem Header="1.5x"  Command="{Binding SetSpeedCommand}" CommandParameter="1.5"/>
                                    <MenuItem Header="2.0x"  Command="{Binding SetSpeedCommand}" CommandParameter="2.0"/>
                                    <MenuItem Header="2.5x"  Command="{Binding SetSpeedCommand}" CommandParameter="2.5"/>
                                    <MenuItem Header="3.0x"  Command="{Binding SetSpeedCommand}" CommandParameter="3.0"/>
                                    <MenuItem Header="4.0x"  Command="{Binding SetSpeedCommand}" CommandParameter="4.0"/>
                                    <MenuItem Header="6.0x"  Command="{Binding SetSpeedCommand}" CommandParameter="6.0"/>
                                    <MenuItem Header="8.0x"  Command="{Binding SetSpeedCommand}" CommandParameter="8.0"/>
                                    <MenuItem Header="10.0x" Command="{Binding SetSpeedCommand}" CommandParameter="10.0"/>
                                    <Separator/>
                                    <MenuItem Header="16x ⚡" Command="{Binding SetSpeedCommand}" CommandParameter="16.0"/>
                                    <MenuItem Header="32x ⚡" Command="{Binding SetSpeedCommand}" CommandParameter="32.0"/>
                                    <MenuItem Header="64x ⚡" Command="{Binding SetSpeedCommand}" CommandParameter="64.0"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource VectorIconAccent}"
                                                Content="{StaticResource IconSpeed}"
                                                Width="12" Height="12" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding PlaybackSpeedText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ── ZOOM button ──────────────────────────────────── -->
                        <Button Style="{StaticResource SpeedButtonStyle}"
                                ToolTip="Zoom video: 25%/50%/100%/150%/200%/Fit (Ctrl+= / Ctrl+- / Ctrl+0)"
                                Click="ZoomButton_Click"
                                Margin="0,0,4,0">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="── ZOOM VIDEO ──" IsEnabled="False" Foreground="{StaticResource BrushTextSecondary}" FontSize="10"/>
                                    <MenuItem Header="Fit màn hình (Ctrl+0)"
                                              Command="{Binding FitToScreenCommand}"
                                              FontWeight="SemiBold"/>
                                    <Separator/>
                                    <MenuItem Header="25%" Command="{Binding SetZoomCommand}" CommandParameter="0.25"/>
                                    <MenuItem Header="50%" Command="{Binding SetZoomCommand}" CommandParameter="0.5"/>
                                    <MenuItem Header="100%" Command="{Binding SetZoomCommand}" CommandParameter="1.0" FontWeight="SemiBold"/>
                                    <MenuItem Header="150%" Command="{Binding SetZoomCommand}" CommandParameter="1.5"/>
                                    <MenuItem Header="200%" Command="{Binding SetZoomCommand}" CommandParameter="2.0"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource VectorIconAccent}"
                                                Content="{StaticResource IconZoom}"
                                                Width="13" Height="13" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding VideoZoomText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ── ROTATE button ────────────────────────────────── -->
                        <Button Style="{StaticResource SpeedButtonStyle}"
                                ToolTip="Xoay video: 90°/180°/270°/360° (Ctrl+R: Xoay phải | Ctrl+Shift+R: Xoay trái)"
                                Click="RotateButton_Click"
                                Margin="0,0,6,0">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="── XOAY VIDEO ──" IsEnabled="False" Foreground="{StaticResource BrushTextSecondary}" FontSize="10"/>
                                    <MenuItem Header="0° / 360° – Chuẩn (Bình thường)" Command="{Binding SetRotationCommand}" CommandParameter="0" FontWeight="SemiBold"/>
                                    <MenuItem Header="90° – Xoay phải 90° (CW)" Command="{Binding SetRotationCommand}" CommandParameter="90"/>
                                    <MenuItem Header="180° – Xoay lật 180°" Command="{Binding SetRotationCommand}" CommandParameter="180"/>
                                    <MenuItem Header="270° – Xoay trái 90° / 270°" Command="{Binding SetRotationCommand}" CommandParameter="270"/>
                                    <MenuItem Header="360° – Về lại 360° (0°)" Command="{Binding SetRotationCommand}" CommandParameter="0"/>
                                    <Separator/>
                                    <MenuItem Header="⟳ Xoay tiếp 90° (Ctrl+R)" Command="{Binding RotateCWCommand}"/>
                                    <MenuItem Header="⟲ Xoay ngược 90° (Ctrl+Shift+R)" Command="{Binding RotateCCWCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource VectorIconAccent}"
                                                Content="{StaticResource IconRotate}"
                                                Width="13" Height="13" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding VideoRotationText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Mute button -->
                        <Button Style="{StaticResource IconButtonStyle}" Padding="8"
                                Command="{Binding ToggleMuteCommand}" ToolTip="Tắt tiếng (M)">
                            <Grid>
                                <!-- Volume high (not muted) -->
                                <ContentControl Style="{StaticResource VectorIcon}"
                                                Content="{StaticResource IconVolumeHigh}"
                                                Width="20" Height="20"
                                                Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisInv}}"/>
                                <!-- Volume mute -->
                                <ContentControl Style="{StaticResource VectorIconSecondary}"
                                                Content="{StaticResource IconVolumeMute}"
                                                Width="20" Height="20"
                                                Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Button>

                        <!-- Volume slider -->
                        <Slider Style="{StaticResource VolumeSliderStyle}"
                                Minimum="0" Maximum="200" Value="{Binding Volume}"
                                Width="80" VerticalAlignment="Center" Margin="0,0,4,0"
                                ToolTip="{Binding Volume, StringFormat='Âm lượng: {0:0}%'}"/>

                        <!-- Volume text -->
                        <TextBlock Text="{Binding Volume, StringFormat='{}{0:0}%'}" FontSize="11" FontFamily="Consolas"
                                   Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"
                                   Width="36" TextAlignment="Center"/>

                        <!-- Stop -->
                        <Button Style="{StaticResource IconButtonStyle}" Padding="8" Margin="4,0,0,0"
                                Command="{Binding StopCommand}" ToolTip="Dừng">
                            <ContentControl Style="{StaticResource VectorIcon}"
                                            Content="{StaticResource IconStop}"
                                            Width="20" Height="20"/>
                        </Button>

                        <!-- Fullscreen -->
                        <Button Style="{StaticResource IconButtonStyle}" Padding="8"
                                Command="{Binding ToggleFullscreenCommand}" ToolTip="Toàn màn hình (F)">
                            <Grid>
                                <!-- Expand to fullscreen -->
                                <ContentControl Style="{StaticResource VectorIcon}"
                                                Content="{StaticResource IconFullscreen}"
                                                Width="20" Height="20"
                                                Visibility="{Binding IsFullscreen, Converter={StaticResource BoolToVisInv}}"/>
                                <!-- Exit fullscreen -->
                                <ContentControl Style="{StaticResource VectorIcon}"
                                                Content="{StaticResource IconFullscreenExit}"
                                                Width="20" Height="20"
                                                Visibility="{Binding IsFullscreen, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
